@using MudBlazor
@using WEB1.Module.DTOs

<div class="p-2">
    <div class="row g-3">
        <div class="col-12">
            <MudTextField T="string" 
                          Label="Nombre de la Institución *" 
                          @bind-Value="Institucion.Nombre" 
                          Required="true"
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        <div class="col-12">
            <MudTextField T="string" 
                          Label="Dirección (Opcional)" 
                          @bind-Value="Institucion.Direccion" 
                          Lines="2" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        @if (EsEdicion)
        {
            <div class="col-12">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="switchInstitucionEstadoModal" @bind="Institucion.EstaHabilitado">
                    <label class="form-check-label fw-semibold text-body" for="switchInstitucionEstadoModal">
                        @(Institucion.EstaHabilitado ? "Institución Activa" : "Institución Inactiva")
                    </label>
                </div>
            </div>
        }

        <div class="col-12 d-flex flex-column-reverse flex-sm-row justify-content-sm-end gap-2 mt-4 pt-2 border-top border-secondary-subtle">
            <button type="button" class="btn btn-outline-secondary px-4 w-100 w-sm-auto" @onclick="OnCancel" disabled="@Cargando">
                Cancelar
            </button>
            <button type="button" class="btn btn-primary px-4 shadow-sm w-100 w-sm-auto" @onclick="HandleSubmit" disabled="@Cargando">
                @if (Cargando)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <i class="fa-solid fa-circle-check me-1"></i>
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public InstitucionDTO Institucion { get; set; } = new();
    [Parameter] public bool EsEdicion { get; set; } = false;
    [Parameter] public bool Cargando { get; set; } = false;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync();
        }
    }
}
