@using MudBlazor
@using WEB1.Module.DTOs

<div class="p-2">
    <div class="row g-3">
        <div class="col-12">
            <MudTextField T="string" 
                          Label="Nombre Completo" 
                          @bind-Value="Cliente.Nombre" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        <div class="col-12 col-md-6">
            <MudTextField T="string" 
                          Label="Teléfono / Celular" 
                          @bind-Value="Cliente.Celular" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        <div class="col-12 col-md-6">
            <MudTextField T="string" 
                          Label="Correo Electrónico (Opcional)" 
                          @bind-Value="Cliente.Correo" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        <div class="col-12 col-md-6">
            <MudSelect T="string" 
                       Label="Estado Civil" 
                       @bind-Value="Cliente.EstadoCivil" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("Soltero(a)")">Soltero(a)</MudSelectItem>
                <MudSelectItem Value="@("Casado(a)")">Casado(a)</MudSelectItem>
                <MudSelectItem Value="@("Divorciado(a)")">Divorciado(a)</MudSelectItem>
                <MudSelectItem Value="@("Viudo(a)")">Viudo(a)</MudSelectItem>
            </MudSelect>
        </div>

        <div class="col-12 col-md-6">
            <MudDatePicker Label="Fecha de Nacimiento" 
                           @bind-Date="FechaNacimiento" 
                           Variant="Variant.Outlined" 
                           Margin="Margin.Dense"
                           DateFormat="dd/MM/yyyy" />
        </div>

        <div class="col-12">
            <MudTextField T="string" 
                          Label="Dirección" 
                          @bind-Value="Cliente.Direccion" 
                          Lines="2" 
                          Variant="Variant.Outlined" 
                          Margin="Margin.Dense"
                          FullWidth="true" />
        </div>

        @if (EsEdicion)
        {
            <div class="col-12">
                <div class="form-check form-switch mt-2">
                    <input class="form-check-input" type="checkbox" id="switchClienteEstadoModal" @bind="Cliente.EstaHabilitado">
                    <label class="form-check-label fw-semibold text-body" for="switchClienteEstadoModal">
                        @(Cliente.EstaHabilitado ? "Cliente Activo" : "Cliente Inactivo")
                    </label>
                </div>
            </div>
        }

        <div class="col-12 d-flex flex-column-reverse flex-sm-row justify-content-sm-end gap-2 mt-4 pt-2 border-top border-secondary-subtle">
            <button type="button" class="btn btn-outline-secondary px-4 w-100 w-sm-auto" @onclick="OnCancel" disabled="@Cargando">
                Cancelar
            </button>
            <button type="button" class="btn btn-primary px-4 shadow-sm w-100 w-sm-auto" @onclick="HandleSubmit" disabled="@Cargando">
                @if (Cargando)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <i class="fa-solid fa-circle-check me-1"></i>
                    <span>Guardar</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public ClienteDTO Cliente { get; set; } = new();
    [Parameter] public DateTime? FechaNacimiento { get; set; }
    [Parameter] public EventCallback<DateTime?> FechaNacimientoChanged { get; set; }
    [Parameter] public bool EsEdicion { get; set; } = false;
    [Parameter] public bool Cargando { get; set; } = false;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (FechaNacimiento.HasValue)
        {
            Cliente.FechaNacimiento = DateOnly.FromDateTime(FechaNacimiento.Value);
        }
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync();
        }
    }
}

