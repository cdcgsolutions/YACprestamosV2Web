@page "/clientes"
@using MudBlazor
@using WEB1.Module.DTOs
@using WEB1.Module.CLIENT.RN
@using WEB1.Module.Client.Services
@inject DataMasterApi Api
@inject FloatingMessage msj
@inject LayoutService LayoutService

<PageTitle>Clientes | YAC-Préstamos</PageTitle>

@if (_cargando)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <h6 class="mt-3 text-body fw-bold text-uppercase" style="letter-spacing: 1px;">Cargando Clientes...</h6>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-1 px-md-3 mt-1 mt-md-3">
        <!-- Cabecera con Botón de Retroceso estilo SIS.INV.WEB -->
        <div class="card shadow-sm border-0 bg-body mb-2">
            <div class="d-flex align-items-center justify-content-between pt-2 px-2 px-md-3">
                <a href="/" class="btn btn-link text-body p-0 d-flex align-items-center text-decoration-none" title="Volver al Inicio" style="width: 28px;">
                    <i class="fa-solid fa-circle-arrow-left fs-5"></i>
                </a>
                <span class="text-uppercase fw-bold text-body text-center flex-grow-1 mx-1 text-truncate" style="letter-spacing: 0.5px; font-size: 0.92rem;">
                    Gestión de Clientes
                </span>
                <div style="width: 28px;"></div>
            </div>
            <div class="card-body p-2 px-2 px-md-3">
                <div class="row g-2 align-items-center">
                    <!-- Buscador general (ocupa todo el ancho hasta el filtro) -->
                    <div class="col-7 col-md">
                        <MudTextField T="string"
                                      Value="_busqueda"
                                      ValueChanged="OnSearchChanged"
                                      Placeholder="Buscar por nombre, celular, tarjeta..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      FullWidth="true"
                                      Clearable="true"
                                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" }, { "name", "filtro_busqueda_clientes" } })"
                                      Class="bg-body text-body w-100"
                                      Style="font-size: 0.85rem;"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentColor="Color.Primary" />
                    </div>

                    <!-- Filtro por Institución (estilo SIS.INV.WEB) -->
                    <div class="col-5 col-md-3">
                        <select class="form-select form-select-sm shadow-sm w-100" 
                                style="height: 38px; font-size: 0.85rem;"
                                @onchange="OnFiltroInstitucionSelect">
                            <option value="">Todas las instituciones</option>
                            <option value="-1">Sin Institución</option>
                            @foreach (var inst in _instituciones)
                            {
                                <option value="@inst.IdInstitucion">@inst.Nombre</option>
                            }
                        </select>
                    </div>

                    <!-- Botones en Desktop (visibles solo en d-md-block) -->
                    <div class="col-md-auto d-none d-md-block">
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary btn-sm shadow-sm px-3 py-2 d-flex align-items-center gap-1"
                                    @onclick="AbrirModalNuevaInstitucion">
                                <i class="fa-solid fa-building"></i>
                                <span class="fw-semibold">Nueva Institución</span>
                            </button>

                            <button type="button" class="btn btn-primary btn-sm shadow-sm px-3 py-2 d-flex align-items-center gap-1"
                                    @onclick="AbrirModalCrear">
                                <i class="fa-solid fa-user-plus"></i>
                                <span class="fw-bold">Nuevo Cliente</span>
                            </button>
                        </div>
                    </div>

                    <!-- Botones responsivos rápidos (visibles solo en móvil d-md-none estilo SIS.INV.WEB) -->
                    <div class="col-12 d-md-none mt-1">
                        <div class="row g-1">
                            <div class="col-6">
                                <button type="button" class="btn btn-outline-primary btn-sm w-100 py-2 px-1 shadow-sm d-flex align-items-center justify-content-center gap-1"
                                        style="font-size: 0.75rem;"
                                        @onclick="AbrirModalNuevaInstitucion">
                                    <i class="fa-solid fa-building"></i>
                                    <span class="fw-semibold">Institución</span>
                                </button>
                            </div>
                            <div class="col-6">
                                <button type="button" class="btn btn-primary btn-sm w-100 py-2 px-1 shadow-sm d-flex align-items-center justify-content-center gap-1"
                                        style="font-size: 0.75rem;"
                                        @onclick="AbrirModalCrear">
                                    <i class="fa-solid fa-user-plus"></i>
                                    <span class="fw-bold">Nuevo Cliente</span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Vista Escritorio: Tabla en Card -->
        <div class="card shadow-sm border-0 bg-body mb-3 d-none d-md-block">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="bg-body-secondary text-body fw-semibold">
                            <tr>
                                <th class="ps-3 py-3" style="width: 70px;">ID</th>
                                <th>Nombre Completo</th>
                                <th>Institución</th>
                                <th>Tarjeta / Contrato</th>
                                <th>Contacto</th>
                                <th>Estado Civil</th>
                                <th>Dirección</th>
                                <th class="text-center" style="width: 100px;">Estado</th>
                                <th class="text-center pe-3" style="width: 100px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_clientes.Any())
                            {
                                @foreach (var cliente in _clientes)
                                {
                                    <tr>
                                        <td class="ps-3">
                                             <span class="fw-bold text-primary font-monospace">#@cliente.IdCliente</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-body">@cliente.Nombre</div>
                                            @if (cliente.FechaNacimiento.HasValue)
                                            {
                                                <small class="text-body-secondary"><i class="fa-solid fa-calendar-day me-1"></i>Nac.: @cliente.FechaNacimiento.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(cliente.InstitucionNombre) && cliente.InstitucionNombre != "Sin Institución")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    <i class="fa-solid fa-building me-1"></i>@cliente.InstitucionNombre
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-body-tertiary text-body-secondary border px-2 py-1">
                                                    Sin Institución
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-body small">
                                                <i class="fa-regular fa-credit-card me-1 text-primary"></i>@FormatearTarjeta(cliente.NumeroTarjetaCredito)
                                            </div>
                                            @if (cliente.FechaInicioContrato.HasValue || cliente.FechaFinContrato.HasValue)
                                            {
                                                <small class="text-body-secondary d-block" style="font-size: 0.75rem;">
                                                    <i class="fa-solid fa-briefcase me-1"></i>
                                                    @(cliente.FechaInicioContrato.HasValue ? cliente.FechaInicioContrato.Value.ToString("dd/MM/yy") : "?") al @(cliente.FechaFinContrato.HasValue ? cliente.FechaFinContrato.Value.ToString("dd/MM/yy") : "Indefinido")
                                                </small>
                                            }
                                        </td>
                                        <td>
                                            <div><i class="fa-solid fa-phone me-1 text-primary"></i>@cliente.Celular</div>
                                            @if (!string.IsNullOrEmpty(cliente.Correo))
                                            {
                                                <small class="text-body-secondary"><i class="fa-solid fa-envelope me-1"></i>@cliente.Correo</small>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-body-tertiary text-body border px-2 py-1">@cliente.EstadoCivil</span>
                                        </td>
                                        <td>
                                            <span class="text-body-secondary small">@(string.IsNullOrWhiteSpace(cliente.Direccion) ? "-" : cliente.Direccion)</span>
                                        </td>
                                        <td class="text-center">
                                            <button type="button" 
                                                    class="btn btn-sm @(cliente.EstaHabilitado ? "btn-success text-white shadow-sm" : "btn-danger text-white opacity-75") fw-bold py-0 px-2"
                                                    style="font-size: 0.72rem;"
                                                    @onclick="() => CambiarEstado(cliente)">
                                                @(cliente.EstaHabilitado ? "ACTIVO" : "INACTIVO")
                                            </button>
                                        </td>
                                        <td class="text-center pe-3">
                                            <div class="d-flex justify-content-center gap-1">
                                                <button type="button" class="btn btn-outline-primary btn-sm border-0" title="Editar Cliente"
                                                        @onclick="() => AbrirModalEditar(cliente)">
                                                    <i class="fa-solid fa-pen-to-square fs-6"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-body-secondary">
                                        <i class="fa-solid fa-users fs-1 d-block opacity-50 mb-2"></i>
                                        <span>No se encontraron clientes registrados.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <!-- Paginación (Escritorio) -->
            <div class="card-footer bg-body border-0 py-3 d-flex justify-content-center">
                <MudPagination Selected="_paginaActual"
                               SelectedChanged="OnPageChanged"
                               Count="_totalPaginas"
                               Color="Color.Primary"
                               Variant="Variant.Filled" />
            </div>
        </div>

        <!-- Vista Móvil: Tarjetas individuales directas (sin card externo que las aleje de los bordes) -->
        <div class="d-block d-md-none mb-3">
                @if (_clientes.Any())
                {
                    @foreach (var cliente in _clientes)
                    {
                        <div class="card mb-2 border-0 shadow-sm bg-body rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary-subtle">
                                    <span class="fw-bold text-primary font-monospace" style="font-size: 0.85rem;">#@cliente.IdCliente</span>
                                    <button type="button" 
                                            class="btn btn-sm @(cliente.EstaHabilitado ? "btn-success text-white shadow-sm" : "btn-danger text-white opacity-75") fw-bold py-0 px-2" 
                                            style="font-size: 0.68rem;" 
                                            @onclick="() => CambiarEstado(cliente)">
                                        @(cliente.EstaHabilitado ? "ACTIVO" : "INACTIVO")
                                    </button>
                                </div>
                                
                                <div class="fw-bold text-body fs-6 mb-1">@cliente.Nombre</div>
                                
                                <div class="mb-2">
                                    @if (!string.IsNullOrEmpty(cliente.InstitucionNombre) && cliente.InstitucionNombre != "Sin Institución")
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                            <i class="fa-solid fa-building me-1"></i>@cliente.InstitucionNombre
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-body-tertiary text-body-secondary border px-2 py-1">
                                            Sin Institución
                                        </span>
                                    }
                                </div>

                                <div class="text-body-secondary small mb-1">
                                    <i class="fa-regular fa-credit-card me-1 text-primary"></i>@FormatearTarjeta(cliente.NumeroTarjetaCredito)
                                </div>

                                @if (cliente.FechaInicioContrato.HasValue || cliente.FechaFinContrato.HasValue)
                                {
                                    <div class="text-body-secondary small mb-1">
                                        <i class="fa-solid fa-briefcase me-1 text-primary"></i>Contrato: @(cliente.FechaInicioContrato.HasValue ? cliente.FechaInicioContrato.Value.ToString("dd/MM/yy") : "?") al @(cliente.FechaFinContrato.HasValue ? cliente.FechaFinContrato.Value.ToString("dd/MM/yy") : "Indefinido")
                                    </div>
                                }

                                <div class="text-body-secondary small mb-1">
                                    <i class="fa-solid fa-phone me-1 text-primary"></i>@cliente.Celular
                                    @if (!string.IsNullOrEmpty(cliente.Correo))
                                    {
                                        <span class="ms-2"><i class="fa-solid fa-envelope me-1 text-primary"></i>@cliente.Correo</span>
                                    }
                                </div>

                                @if (cliente.FechaNacimiento.HasValue)
                                {
                                    <div class="text-body-secondary small mb-1">
                                        <i class="fa-solid fa-calendar-day me-1 text-primary"></i>Nac.: @cliente.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(cliente.Direccion))
                                {
                                    <div class="text-body-secondary small mb-2">
                                        <i class="fa-solid fa-location-dot me-1 text-primary"></i>@cliente.Direccion
                                    </div>
                                }

                                <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary-subtle">
                                    <span class="badge bg-body-tertiary text-body border px-2 py-1">@cliente.EstadoCivil</span>
                                    <button type="button" class="btn btn-outline-primary btn-sm px-3 shadow-sm"
                                            @onclick="() => AbrirModalEditar(cliente)">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Editar
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="card border-0 shadow-sm bg-body text-center py-5 text-body-secondary">
                        <i class="fa-solid fa-users fs-1 opacity-50 mb-2"></i>
                        <span>No se encontraron clientes registrados.</span>
                    </div>
                }

                <div class="py-2 d-flex justify-content-center">
                    <MudPagination Selected="_paginaActual"
                                   SelectedChanged="OnPageChanged"
                                   Count="_totalPaginas"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled" />
                </div>
            </div>
    </div>
}

<!-- Modal Cliente -->
<AppModal @ref="ModalClienteRef" 
          Id="modalCliente" 
          Title="@(_esEdicion ? $"Editar Cliente #{_clienteModel.IdCliente}" : "Registro de Nuevo Cliente")" 
          TitleIcon="fa-solid fa-address-card"
          HeaderVisible="true" 
          FooterVisible="false"
          Centered="true"
          ModalSize="SizeModal.Large">
    <ModalCliente Cliente="_clienteModel"
                  Instituciones="_instituciones"
                  EsEdicion="_esEdicion"
                  Cargando="_guardando"
                  OnSubmit="GuardarCliente"
                  OnCancel="() => ModalClienteRef.CloseModal()" />
</AppModal>

<!-- Modal Rápido para Nueva Institución (Componente sobre Componente) -->
<AppModal @ref="ModalInstitucionRef"
          Id="modalNuevaInstitucion"
          Title="Registrar Nueva Institución"
          TitleIcon="fa-solid fa-building"
          HeaderVisible="true"
          FooterVisible="false"
          Centered="true"
          ModalSize="SizeModal.Large">
    <ModalInstitucion Institucion="_nuevaInstitucion"
                      Cargando="_guardandoInstitucion"
                      OnSubmit="GuardarInstitucion"
                      OnCancel="() => ModalInstitucionRef.CloseModal()" />
</AppModal>

@code {
    private List<ClienteDTO> _clientes = new();
    private List<InstitucionDTO> _instituciones = new();
    private bool _cargando = true;
    private string _busqueda = "";
    private int? _filtroInstitucion = null;
    private int _paginaActual = 1;
    private int _totalPaginas = 1;
    private const int _tamanoPagina = 10;

    private AppModal ModalClienteRef = default!;
    private AppModal ModalInstitucionRef = default!;
    private ClienteDTO _clienteModel = new();
    private InstitucionDTO _nuevaInstitucion = new();
    private bool _esEdicion = false;
    private bool _guardando = false;
    private bool _guardandoInstitucion = false;

    protected override async Task OnInitializedAsync()
    {
        LayoutService.SetTitle("Gestión de Clientes");
        await CargarInstituciones();
        await CargarDatos(esCargaInicial: true);
    }

    private async Task CargarInstituciones()
    {
        try
        {
            var resInst = await Api.GetInstitucionesAsync(soloActivos: true);
            if (resInst.IsSuccess && resInst.Value != null)
            {
                _instituciones = resInst.Value;
            }
        }
        catch { }
    }

    private async Task CargarDatos(bool esCargaInicial = false)
    {
        if (esCargaInicial)
        {
            _cargando = true;
        }

        try
        {
            var resClientes = await Api.GetClientesPaginadoAndBuscadorAsync(
                _paginaActual,
                _tamanoPagina,
                _busqueda,
                _filtroInstitucion,
                soloActivos: false);

            if (resClientes.IsSuccess && resClientes.Value != null)
            {
                _clientes = resClientes.Value.value ?? new();
                _totalPaginas = resClientes.Value.total;
            }
            else
            {
                await msj.ShowErrorMessage(resClientes.ErrorMessage ?? "Error al cargar clientes");
            }
        }
        catch (Exception ex)
        {
            await msj.ShowErrorMessage("Error al cargar datos: " + ex.Message);
        }
        finally
        {
            _cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OnSearchChanged(string text)
    {
        _busqueda = text;
        _paginaActual = 1;
        await CargarDatos(esCargaInicial: false);
    }

    private async Task OnFiltroInstitucionSelect(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(val))
        {
            _filtroInstitucion = null;
        }
        else if (int.TryParse(val, out var id))
        {
            _filtroInstitucion = id;
        }
        _paginaActual = 1;
        await CargarDatos(esCargaInicial: false);
    }

    private async Task OnFiltroInstitucionChanged(int? idInst)
    {
        _filtroInstitucion = idInst;
        _paginaActual = 1;
        await CargarDatos(esCargaInicial: false);
    }

    private async Task OnPageChanged(int page)
    {
        _paginaActual = page;
        await CargarDatos(esCargaInicial: false);
    }

    private async Task AbrirModalCrear()
    {
        _esEdicion = false;
        _clienteModel = new ClienteDTO 
        { 
            EstaHabilitado = true, 
            EstadoCivil = "Soltero(a)",
            IdInstitucion = null
        };
        await ModalClienteRef.OpenModal();
    }

    private async Task AbrirModalEditar(ClienteDTO cliente)
    {
        _esEdicion = true;
        _clienteModel = new ClienteDTO
        {
            IdCliente = cliente.IdCliente,
            Nombre = cliente.Nombre,
            Celular = cliente.Celular,
            Correo = cliente.Correo,
            EstadoCivil = cliente.EstadoCivil,
            FechaNacimiento = cliente.FechaNacimiento,
            Direccion = cliente.Direccion,
            NumeroTarjetaCredito = cliente.NumeroTarjetaCredito,
            FechaInicioContrato = cliente.FechaInicioContrato,
            FechaFinContrato = cliente.FechaFinContrato,
            IdInstitucion = cliente.IdInstitucion,
            InstitucionNombre = cliente.InstitucionNombre,
            EstaHabilitado = cliente.EstaHabilitado
        };
        await ModalClienteRef.OpenModal();
    }

    private async Task GuardarCliente()
    {
        if (string.IsNullOrWhiteSpace(_clienteModel.Nombre) || string.IsNullOrWhiteSpace(_clienteModel.Celular))
        {
            await msj.ShowWarningMessage("El nombre y el celular son obligatorios.");
            return;
        }

        if (string.IsNullOrWhiteSpace(_clienteModel.NumeroTarjetaCredito))
        {
            await msj.ShowWarningMessage("El número de tarjeta de crédito es obligatorio.");
            return;
        }

        _guardando = true;
        if (_esEdicion)
        {
            var res = await Api.ActualizarClienteAsync(_clienteModel.IdCliente, _clienteModel);
            if (res.IsSuccess)
            {
                await ModalClienteRef.CloseModal();
                await msj.ShowSuccessMessage("Cliente actualizado exitosamente.");
                await CargarDatos(esCargaInicial: false);
            }
            else
            {
                await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al actualizar cliente.");
            }
        }
        else
        {
            var res = await Api.CrearClienteAsync(_clienteModel);
            if (res.IsSuccess)
            {
                await ModalClienteRef.CloseModal();
                await msj.ShowSuccessMessage("Cliente registrado exitosamente.");
                await CargarDatos(esCargaInicial: false);
            }
            else
            {
                await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al registrar cliente.");
            }
        }
        _guardando = false;
    }

    private async Task CambiarEstado(ClienteDTO cliente)
    {
        var res = await Api.CambiarEstadoClienteAsync(cliente.IdCliente);
        if (res.IsSuccess)
        {
            cliente.EstaHabilitado = !cliente.EstaHabilitado;
            await msj.ShowInfoMessage($"Cliente {(cliente.EstaHabilitado ? "habilitado" : "deshabilitado")}");
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al cambiar estado");
        }
    }

    private async Task AbrirModalNuevaInstitucion()
    {
        _nuevaInstitucion = new InstitucionDTO { EstaHabilitado = true };
        await ModalInstitucionRef.OpenModal();
    }

    private async Task GuardarInstitucion()
    {
        if (string.IsNullOrWhiteSpace(_nuevaInstitucion.Nombre))
        {
            await msj.ShowWarningMessage("El nombre de la institución es obligatorio.");
            return;
        }

        _guardandoInstitucion = true;
        var res = await Api.CrearInstitucionAsync(_nuevaInstitucion);
        _guardandoInstitucion = false;

        if (res.IsSuccess)
        {
            await ModalInstitucionRef.CloseModal();
            await msj.ShowSuccessMessage("Institución creada exitosamente.");
            // Recargar lista de instituciones
            var resInst = await Api.GetInstitucionesAsync(soloActivos: true);
            if (resInst.IsSuccess && resInst.Value != null)
            {
                _instituciones = resInst.Value;
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al crear institución.");
        }
    }

    private static string FormatearTarjeta(string? tarjeta)
    {
        if (string.IsNullOrWhiteSpace(tarjeta)) return "-";
        var limpia = tarjeta.Replace("-", "").Replace(" ", "").Trim();
        if (string.IsNullOrEmpty(limpia)) return "-";
        return System.Text.RegularExpressions.Regex.Replace(limpia, ".{4}", "$0-").TrimEnd('-');
    }
}
