@page "/prestamos"
@using MudBlazor
@using WEB1.Module.DTOs
@using WEB1.Module.CLIENT.RN
@using WEB1.Module.Client.Services
@inject DataMasterApi Api
@inject FloatingMessage msj
@inject LayoutService LayoutService

<PageTitle>Préstamos | YAC-Préstamos</PageTitle>

@if (_cargando)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <h6 class="mt-3 text-body fw-bold text-uppercase" style="letter-spacing: 1px;">Cargando Préstamos...</h6>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-3">
        <!-- Cabecera con Botón de Retroceso al Home estilo SIS.INV.WEB -->
        <div class="card shadow-sm border-0 bg-body mb-2">
            <div class="d-flex align-items-center justify-content-center pt-2 px-3 position-relative">
                <div class="position-absolute start-0 ps-3">
                    <a href="/" class="btn btn-link text-body p-0" title="Volver al Inicio">
                        <i class="fa-solid fa-circle-arrow-left fs-5"></i>
                    </a>
                </div>
                <span class="text-uppercase fw-bold text-body" style="letter-spacing: 1px;">
                    Gestión de Préstamos
                </span>
            </div>
            <div class="card-body p-2 px-3">
                <div class="row g-2 align-items-center justify-content-between">
                    <div class="col-12 col-md-5">
                        <MudTextField T="string"
                                      Value="_busqueda"
                                      ValueChanged="OnSearchChanged"
                                      Placeholder="Buscar por cliente, ID o estado..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      FullWidth="true"
                                      Clearable="true"
                                      UserAttributes="@(new Dictionary<string, object> { { "autocomplete", "off" }, { "name", "filtro_busqueda_prestamos" } })"
                                      Class="bg-body text-body"
                                      Style="font-size: 0.85rem;"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      AdornmentColor="Color.Primary" />
                    </div>

                    <div class="col-12 col-md-auto d-flex gap-2 justify-content-end">
                        <button type="button" class="btn btn-primary btn-sm shadow-sm px-3 py-2 d-flex align-items-center gap-1 w-100 justify-content-center justify-content-md-start"
                                @onclick="AbrirModalCrear">
                            <i class="fa-solid fa-circle-plus"></i>
                            <span class="fw-bold">Nuevo Préstamo</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contenedor Responsivo estilo SIS.INV.WEB (Tabla en Escritorio / Tarjetas en Móvil) -->
        <div class="card shadow-sm border-0 bg-body mb-3">
            <!-- Vista Escritorio: Tabla -->
            <div class="card-body p-0 d-none d-md-block">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="bg-body-secondary text-body fw-semibold">
                            <tr>
                                <th class="ps-3 py-3" style="width: 80px;">ID</th>
                                <th>Cliente Prestatario</th>
                                <th class="text-end">Monto Prestado</th>
                                <th class="text-end">Total a Devolver</th>
                                <th class="text-end">Saldo Pendiente</th>
                                <th class="text-center">Modalidad</th>
                                <th class="text-center" style="width: 110px;">Estado</th>
                                <th>Fecha</th>
                                <th class="text-center pe-3" style="width: 140px;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (PrestamosPaginados.Any())
                            {
                                @foreach (var p in PrestamosPaginados)
                                {
                                    <tr>
                                        <td class="ps-3">
                                            <span class="fw-bold text-primary font-monospace">#@p.IdPrestamo</span>
                                        </td>
                                        <td>
                                            <div class="fw-bold text-body">@(p.NombreCliente ?? $"Cliente #{p.IdCliente}")</div>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-semibold text-body">Bs. @p.Monto.ToString("N2")</span>
                                            <div class="small text-body-secondary">+@p.PorcentajeInteres% int.</div>
                                        </td>
                                        <td class="text-end">
                                            <span class="fw-bold text-body">Bs. @p.MontoTotal.ToString("N2")</span>
                                        </td>
                                        <td class="text-end">
                                            @if (p.SaldoPendiente == 0)
                                            {
                                                <span class="fw-bold text-success">Bs. 0.00</span>
                                            }
                                            else
                                            {
                                                <span class="fw-bold text-danger">Bs. @p.SaldoPendiente.ToString("N2")</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-body-tertiary text-body border px-2 py-1">
                                                @p.ModalidadCobro
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (p.Estado == "Pagado")
                                            {
                                                <span class="badge bg-success text-white py-1 px-2">PAGADO</span>
                                            }
                                            else if (p.Estado == "Activo")
                                            {
                                                <span class="badge bg-warning text-dark py-1 px-2">ACTIVO</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-white py-1 px-2">@p.Estado.ToUpper()</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-body-secondary"><i class="fa-solid fa-calendar-days me-1 text-primary"></i>@p.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                        </td>
                                        <td class="text-center pe-3">
                                            <div class="d-flex justify-content-center gap-1">
                                                <!-- Botón Abonar estilo SIS.INV.WEB -->
                                                <button class="btn btn-sm btn-success text-white px-2 py-1 shadow-sm d-flex align-items-center gap-1"
                                                        title="Registrar Abono"
                                                        disabled="@(p.Estado == "Pagado" || p.SaldoPendiente <= 0)"
                                                        @onclick="@(() => AbrirModalAbonar(p))">
                                                    <i class="fa-solid fa-money-bill-wave"></i>
                                                    <span style="font-size: 0.75rem;">Abonar</span>
                                                </button>

                                                <!-- Botón Historial estilo SIS.INV.WEB -->
                                                <button class="btn btn-outline-info btn-sm border-0 px-2"
                                                        title="Ver Historial de Pagos"
                                                        @onclick="@(() => AbrirModalHistorial(p))">
                                                    <i class="fa-solid fa-receipt fs-6"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-5 text-body-secondary">
                                        <i class="fa-solid fa-money-bills fs-1 d-block opacity-50 mb-2"></i>
                                        <span>No se encontraron préstamos registrados.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Vista Móvil: Tarjetas individuales estilo SIS.INV.WEB -->
            <div class="card-body p-2 d-block d-md-none bg-body-tertiary">
                @if (PrestamosPaginados.Any())
                {
                    @foreach (var p in PrestamosPaginados)
                    {
                        <div class="card mb-2 border-0 shadow-sm bg-body rounded-3">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary-subtle">
                                    <span class="fw-bold text-primary font-monospace" style="font-size: 0.85rem;">#@p.IdPrestamo</span>
                                    <div>
                                        <span class="badge bg-body-tertiary text-body border px-2 py-1 me-1">
                                            @p.ModalidadCobro
                                        </span>
                                        @if (p.Estado == "Pagado")
                                        {
                                            <span class="badge bg-success text-white py-1 px-2">PAGADO</span>
                                        }
                                        else if (p.Estado == "Activo")
                                        {
                                            <span class="badge bg-warning text-dark py-1 px-2">ACTIVO</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-white py-1 px-2">@p.Estado.ToUpper()</span>
                                        }
                                    </div>
                                </div>

                                <div class="fw-bold text-body fs-6 mb-2">@(p.NombreCliente ?? $"Cliente #{p.IdCliente}")</div>

                                <div class="p-2 rounded-2 bg-body-tertiary border border-secondary-subtle mb-2">
                                    <div class="d-flex justify-content-between small text-body-secondary mb-1">
                                        <span>Prestado:</span>
                                        <span class="fw-semibold text-body">Bs. @p.Monto.ToString("N2") <small class="text-primary">(+@p.PorcentajeInteres%)</small></span>
                                    </div>
                                    <div class="d-flex justify-content-between small text-body-secondary mb-1">
                                        <span>Total a Devolver:</span>
                                        <span class="fw-bold text-body">Bs. @p.MontoTotal.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between fs-6 fw-bold border-top border-secondary-subtle pt-1 @(p.SaldoPendiente == 0 ? "text-success" : "text-danger")">
                                        <span>Saldo Pendiente:</span>
                                        <span>Bs. @p.SaldoPendiente.ToString("N2")</span>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center text-body-secondary small mb-2">
                                    <span><i class="fa-solid fa-calendar-days me-1 text-primary"></i>@p.FechaRegistro.ToString("dd/MM/yyyy")</span>
                                </div>

                                <div class="d-flex gap-2 pt-2 border-top border-secondary-subtle">
                                    <button class="btn btn-sm btn-success text-white flex-grow-1 py-2 shadow-sm d-flex align-items-center justify-content-center gap-1"
                                            disabled="@(p.Estado == "Pagado" || p.SaldoPendiente <= 0)"
                                            @onclick="@(() => AbrirModalAbonar(p))">
                                        <i class="fa-solid fa-money-bill-wave"></i>
                                        <span>Abonar</span>
                                    </button>
                                    <button class="btn btn-outline-info btn-sm px-3 py-2 d-flex align-items-center justify-content-center gap-1"
                                            @onclick="@(() => AbrirModalHistorial(p))">
                                        <i class="fa-solid fa-receipt"></i>
                                        <span>Historial</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-body-secondary bg-body rounded-3">
                        <i class="fa-solid fa-money-bills fs-2 d-block opacity-50 mb-2"></i>
                        <span>No se encontraron préstamos registrados.</span>
                    </div>
                }
            </div>

            <!-- Paginación con MudPagination -->
            @if (TotalPaginas > 0)
            {
                <div class="card-footer bg-body border-0 py-3 d-flex justify-content-center">
                    <MudPagination Selected="_paginaActual"
                                   SelectedChanged="OnPageChanged"
                                   Count="TotalPaginas"
                                   Color="Color.Primary"
                                   Variant="Variant.Filled" />
                </div>
            }
        </div>
    </div>
}

<!-- Modal Componente sobre Componente: Nuevo Préstamo -->
<AppModal @ref="ModalPrestamoRef" 
          Id="modalPrestamo" 
          Title="Otorgar Nuevo Préstamo" 
          TitleIcon="fa-solid fa-hand-holding-dollar"
          HeaderVisible="true" 
          FooterVisible="false"
          Centered="true">
    <ModalPrestamo Prestamo="_prestamoCreacion"
                   Clientes="_clientes"
                   Cargando="_guardando"
                   OnSubmit="GuardarPrestamo"
                   OnCancel="() => ModalPrestamoRef.CloseModal()" />
</AppModal>

<!-- Modal Componente sobre Componente: Registrar Abono -->
<AppModal @ref="ModalAbonoRef" 
          Id="modalAbono" 
          Title="@($"Abonar a Préstamo #{_prestamoSeleccionado?.IdPrestamo}")" 
          TitleIcon="fa-solid fa-money-bills"
          HeaderVisible="true" 
          FooterVisible="false"
          Centered="true">
    <ModalAbono Prestamo="_prestamoSeleccionado"
                Cargando="_guardando"
                OnSubmit="GuardarAbono"
                OnCancel="() => ModalAbonoRef.CloseModal()" />
</AppModal>

<!-- Modal Componente sobre Componente: Historial de Abonos -->
<AppModal @ref="ModalHistorialRef" 
          Id="modalHistorial" 
          Title="@($"Historial de Pagos - Préstamo #{_historial?.IdPrestamo}")" 
          TitleIcon="fa-solid fa-receipt"
          HeaderVisible="true" 
          FooterVisible="false"
          ModalSize="SizeModal.Large"
          Centered="true">
    <ModalHistorialPagos Historial="_historial"
                         OnClose="() => ModalHistorialRef.CloseModal()" />
</AppModal>

@code {
    private List<PrestamoDTO> _prestamos = new();
    private List<ClienteDTO> _clientes = new();
    private bool _cargando = true;
    private string _busqueda = "";
    private int _paginaActual = 1;
    private const int _tamanoPagina = 10;

    private AppModal ModalPrestamoRef = default!;
    private AppModal ModalAbonoRef = default!;
    private AppModal ModalHistorialRef = default!;

    private PrestamoCreacionDTO _prestamoCreacion = new();
    private PrestamoDTO? _prestamoSeleccionado;
    private decimal _montoAbonar = 0;
    private ResumenHistorialPagosDTO? _historial;
    private bool _guardando = false;

    protected override async Task OnInitializedAsync()
    {
        LayoutService.SetTitle("Gestión de Préstamos");
        await CargarDatos(esCargaInicial: true);
    }

    private async Task CargarDatos(bool esCargaInicial = false)
    {
        if (esCargaInicial)
        {
            _cargando = true;
        }

        try
        {
            var prestamosTask = Api.GetPrestamosAsync();
            var clientesTask = Api.GetClientesAsync();

            await Task.WhenAll(prestamosTask, clientesTask);

            var resPrestamos = await prestamosTask;
            var resClientes = await clientesTask;

            if (resPrestamos.IsSuccess && resPrestamos.Value != null)
            {
                _prestamos = resPrestamos.Value;
            }
            else
            {
                await msj.ShowErrorMessage(resPrestamos.ErrorMessage ?? "Error al cargar préstamos");
            }

            if (resClientes.IsSuccess && resClientes.Value != null)
            {
                _clientes = resClientes.Value;
            }
        }
        catch (Exception ex)
        {
            await msj.ShowErrorMessage("Error al cargar datos de préstamos: " + ex.Message);
        }
        finally
        {
            _cargando = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private IEnumerable<PrestamoDTO> PrestamosFiltrados => _prestamos.Where(p =>
        string.IsNullOrWhiteSpace(_busqueda) ||
        p.IdPrestamo.ToString().Contains(_busqueda) ||
        (!string.IsNullOrEmpty(p.NombreCliente) && p.NombreCliente.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(p.Estado) && p.Estado.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)) ||
        (!string.IsNullOrEmpty(p.ModalidadCobro) && p.ModalidadCobro.Contains(_busqueda, StringComparison.OrdinalIgnoreCase)));

    private IEnumerable<PrestamoDTO> PrestamosPaginados =>
        PrestamosFiltrados.Skip((_paginaActual - 1) * _tamanoPagina).Take(_tamanoPagina);

    private int TotalPaginas => (int)Math.Ceiling((double)PrestamosFiltrados.Count() / _tamanoPagina);

    private void OnSearchChanged(string text)
    {
        _busqueda = text;
        _paginaActual = 1;
    }

    private void OnPageChanged(int page)
    {
        _paginaActual = page;
    }

    private async Task AbrirModalCrear()
    {
        if (!_clientes.Any(c => c.EstaHabilitado))
        {
            await msj.ShowWarningMessage("Debe registrar al menos un cliente activo antes de crear préstamos.");
            return;
        }

        _prestamoCreacion = new PrestamoCreacionDTO
        {
            IdCliente = _clientes.First(c => c.EstaHabilitado).IdCliente,
            Monto = 1000,
            PorcentajeInteres = 10,
            ModalidadCobro = "Mensual"
        };
        await ModalPrestamoRef.OpenModal();
    }

    private async Task GuardarPrestamo()
    {
        _guardando = true;
        var res = await Api.CrearPrestamoAsync(_prestamoCreacion);
        if (res.IsSuccess)
        {
            await ModalPrestamoRef.CloseModal();
            await msj.ShowSuccessMessage("¡Préstamo otorgado exitosamente!");
            await CargarDatos(esCargaInicial: false);
        }
        else
        {
            await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al registrar préstamo");
        }
        _guardando = false;
    }

    private async Task AbrirModalAbonar(PrestamoDTO prestamo)
    {
        _prestamoSeleccionado = prestamo;
        _montoAbonar = 0;
        await ModalAbonoRef.OpenModal();
    }

    private async Task GuardarAbono(decimal monto)
    {
        if (_prestamoSeleccionado == null || monto <= 0) return;

        _guardando = true;
        var abono = new RegistrarAbonoDTO
        {
            IdPrestamo = _prestamoSeleccionado.IdPrestamo,
            MontoAbonado = monto
        };

        var res = await Api.RegistrarAbonoAsync(abono);
        if (res.IsSuccess)
        {
            await ModalAbonoRef.CloseModal();
            await msj.ShowSuccessMessage("¡Abono registrado con éxito!");
            await CargarDatos(esCargaInicial: false);
        }
        else
        {
            await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al registrar abono");
        }
        _guardando = false;
    }

    private async Task AbrirModalHistorial(PrestamoDTO prestamo)
    {
        var res = await Api.GetHistorialPagosAsync(prestamo.IdPrestamo);
        if (res.IsSuccess && res.Value != null)
        {
            _historial = res.Value;
            await ModalHistorialRef.OpenModal();
        }
        else
        {
            await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al obtener historial");
        }
    }
}
