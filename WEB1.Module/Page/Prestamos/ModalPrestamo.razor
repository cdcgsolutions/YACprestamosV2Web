@using MudBlazor
@using WEB1.Module.DTOs

<div class="p-2">
    <div class="row g-3">
        <div class="col-12">
            <MudSelect T="int" 
                       Label="Cliente Prestatario" 
                       @bind-Value="Prestamo.IdCliente" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter">
                @foreach (var c in Clientes.Where(x => x.EstaHabilitado))
                {
                    <MudSelectItem Value="@c.IdCliente">@c.Nombre - @c.Celular</MudSelectItem>
                }
            </MudSelect>
        </div>

        <div class="col-12 col-md-6">
            <MudNumericField T="decimal" 
                             Label="Monto Principal (Bs.)" 
                             @bind-Value="Prestamo.Monto" 
                             Min="1" 
                             Variant="Variant.Outlined" 
                             Margin="Margin.Dense" />
        </div>

        <div class="col-12 col-md-6">
            <MudNumericField T="decimal" 
                             Label="Interés (%)" 
                             @bind-Value="Prestamo.PorcentajeInteres" 
                             Min="0" 
                             Variant="Variant.Outlined" 
                             Margin="Margin.Dense" />
        </div>

        <div class="col-12">
            <MudSelect T="string" 
                       Label="Modalidad de Cobro" 
                       @bind-Value="Prestamo.ModalidadCobro" 
                       Variant="Variant.Outlined" 
                       Margin="Margin.Dense"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("Diario")">Diario</MudSelectItem>
                <MudSelectItem Value="@("Semanal")">Semanal</MudSelectItem>
                <MudSelectItem Value="@("Quincenal")">Quincenal</MudSelectItem>
                <MudSelectItem Value="@("Mensual")">Mensual</MudSelectItem>
            </MudSelect>
        </div>

        <!-- Resumen en Vivo con tokens temáticos -->
        <div class="col-12">
            <div class="p-3 bg-body-tertiary rounded-3 border border-secondary-subtle">
                <div class="d-flex justify-content-between text-body-secondary small mb-1">
                    <span>Interés a cobrar:</span>
                    <span class="fw-bold text-body">Bs. @((Prestamo.Monto * (Prestamo.PorcentajeInteres / 100m)).ToString("N2"))</span>
                </div>
                <div class="d-flex justify-content-between text-primary fs-6 fw-bold border-top border-secondary-subtle pt-2">
                    <span>Total a Devolver:</span>
                    <span>Bs. @((Prestamo.Monto + (Prestamo.Monto * (Prestamo.PorcentajeInteres / 100m))).ToString("N2"))</span>
                </div>
            </div>
        </div>

        <div class="col-12 d-flex flex-column-reverse flex-sm-row justify-content-sm-end gap-2 mt-3 pt-2 border-top border-secondary-subtle">
            <button type="button" class="btn btn-outline-secondary px-4 w-100 w-sm-auto" @onclick="OnCancel" disabled="@Cargando">
                Cancelar
            </button>
            <button type="button" class="btn btn-primary px-4 shadow-sm w-100 w-sm-auto" @onclick="HandleSubmit" disabled="@(Cargando || Prestamo.Monto <= 0 || Prestamo.IdCliente <= 0)">
                @if (Cargando)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Guardando...</span>
                }
                else
                {
                    <i class="fa-solid fa-circle-check me-1"></i>
                    <span>Otorgar Préstamo</span>
                }
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public PrestamoCreacionDTO Prestamo { get; set; } = new();
    [Parameter] public List<ClienteDTO> Clientes { get; set; } = new();
    [Parameter] public bool Cargando { get; set; } = false;
    [Parameter] public EventCallback OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync();
        }
    }
}

