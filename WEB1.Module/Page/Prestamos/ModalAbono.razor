@using MudBlazor
@using WEB1.Module.DTOs

<div class="p-2">
    @if (Prestamo != null)
    {
        <div class="p-3 bg-body-tertiary rounded-3 border border-secondary-subtle mb-3">
            <div class="small text-body-secondary mb-1">Cliente:</div>
            <div class="fw-bold text-body fs-6 mb-2">@Prestamo.NombreCliente</div>
            <div class="d-flex justify-content-between text-body-secondary small">
                <span>Monto Total:</span>
                <span class="fw-bold text-body">Bs. @Prestamo.MontoTotal.ToString("N2")</span>
            </div>
            <div class="d-flex justify-content-between text-danger fw-bold fs-6 mt-1 border-top border-secondary-subtle pt-1">
                <span>Saldo Pendiente:</span>
                <span>Bs. @Prestamo.SaldoPendiente.ToString("N2")</span>
            </div>
        </div>

        <div class="mb-3">
            <MudNumericField T="decimal" 
                             Label="Monto a Abonar (Bs.)" 
                             @bind-Value="MontoAbonar" 
                             Min="0.01m" 
                             Max="@Prestamo.SaldoPendiente"
                             Variant="Variant.Outlined" 
                             Margin="Margin.Dense" />
            <div class="d-flex justify-content-end mt-1">
                <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-semibold" style="font-size: 0.78rem;"
                        @onclick="() => MontoAbonar = Prestamo.SaldoPendiente">
                    <i class="fa-solid fa-coins me-1"></i>Pagar todo el saldo (Bs. @Prestamo.SaldoPendiente.ToString("N2"))
                </button>
            </div>
        </div>

        @if (MontoAbonar > Prestamo.SaldoPendiente)
        {
            <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-2" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-6"></i>
                <span>El abono no puede superar la deuda pendiente (Máximo: <strong>Bs. @Prestamo.SaldoPendiente.ToString("N2")</strong>).</span>
            </div>
        }
        else if (MontoAbonar > 0)
        {
            <div class="d-flex justify-content-between @(Prestamo.SaldoPendiente - MontoAbonar == 0 ? "text-primary" : "text-success") fw-bold small mb-2 px-1">
                <span>@(Prestamo.SaldoPendiente - MontoAbonar == 0 ? "¡Préstamo quedará totalmente liquidado!" : "Nuevo Saldo Restante tras este abono:")</span>
                <span>Bs. @((Prestamo.SaldoPendiente - MontoAbonar).ToString("N2"))</span>
            </div>
        }

        <div class="d-flex flex-column-reverse flex-sm-row justify-content-sm-end gap-2 pt-2 border-top border-secondary-subtle">
            <button type="button" class="btn btn-outline-secondary px-4 w-100 w-sm-auto" @onclick="OnCancel" disabled="@Cargando">
                Cancelar
            </button>
            <button type="button" class="btn btn-success text-white px-4 shadow-sm w-100 w-sm-auto" @onclick="HandleSubmit" disabled="@(Cargando || MontoAbonar <= 0 || MontoAbonar > Prestamo.SaldoPendiente)">
                @if (Cargando)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Registrando...</span>
                }
                else
                {
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    <span>Registrar Abono</span>
                }
            </button>
        </div>
    }
</div>

@code {
    [Parameter] public PrestamoDTO? Prestamo { get; set; }
    [Parameter] public decimal MontoAbonar { get; set; }
    [Parameter] public EventCallback<decimal> MontoAbonarChanged { get; set; }
    [Parameter] public bool Cargando { get; set; } = false;
    [Parameter] public EventCallback<decimal> OnSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task HandleSubmit()
    {
        if (OnSubmit.HasDelegate)
        {
            await OnSubmit.InvokeAsync(MontoAbonar);
        }
    }
}

