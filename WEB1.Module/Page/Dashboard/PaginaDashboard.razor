@page "/dashboard"
@using MudBlazor
@using WEB1.Module.DTOs
@using WEB1.Module.CLIENT.RN
@using WEB1.Module.Client.Services
@inject DataMasterApi Api
@inject FloatingMessage msj
@inject LayoutService LayoutService
@inject IJSRuntime JS

<PageTitle>Dashboard | YAC-Préstamos</PageTitle>

@if (_cargandoInicial)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="text-center">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Cargando métricas...</span>
            </div>
            <h6 class="mt-3 text-body fw-bold text-uppercase" style="letter-spacing: 1px;">Cargando Dashboard...</h6>
        </div>
    </div>
}
else
{
    <div class="container-fluid mt-3">
        <!-- Cabecera con Botón de Retroceso y Barra de Filtros Integrada -->
        <div class="card shadow-sm border-0 bg-body mb-3">
            <div class="d-flex align-items-center justify-content-center pt-2 px-3 position-relative">
                <div class="position-absolute start-0 ps-3">
                    <a href="/" class="btn btn-link text-body p-0" title="Volver al Inicio">
                        <i class="fa-solid fa-circle-arrow-left fs-5"></i>
                    </a>
                </div>
                <span class="text-uppercase fw-bold text-body" style="letter-spacing: 1px;">
                    Dashboard Financiero
                </span>
            </div>

            <div class="card-body p-3">
                <MudGrid Spacing="2" Class="align-center">
                    <!-- 1. Institución -->
                    <MudItem xs="12" sm="6" md="3">
                        <MudSelect T="int?" 
                                   Label="Institución" 
                                   Value="_filtroInstitucion" 
                                   ValueChanged="OnInstitucionChanged" 
                                   Dense="true" 
                                   Margin="Margin.Dense" 
                                   Variant="Variant.Outlined" 
                                   AnchorOrigin="Origin.BottomLeft" 
                                   TransformOrigin="Origin.TopLeft"
                                   RelativeWidth="DropdownWidth.Relative"
                                   FullWidth="true">
                            <MudSelectItem T="int?" Value="@((int?)null)">Todas las instituciones</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)-1)">Sin Institución</MudSelectItem>
                            @foreach (var inst in _instituciones)
                            {
                                <MudSelectItem T="int?" Value="@((int?)inst.IdInstitucion)">@inst.Nombre</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- 2. Modalidad -->
                    <MudItem xs="6" sm="3" md="2">
                        <MudSelect T="string" 
                                   Label="Modalidad" 
                                   Value="_filtroModalidad" 
                                   ValueChanged="OnModalidadChanged" 
                                   Dense="true" 
                                   Margin="Margin.Dense" 
                                   Variant="Variant.Outlined" 
                                   AnchorOrigin="Origin.BottomLeft" 
                                   TransformOrigin="Origin.TopLeft"
                                   RelativeWidth="DropdownWidth.Relative"
                                   FullWidth="true">
                            <MudSelectItem T="string" Value="@("")">Todas</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Diario")">Diario</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Semanal")">Semanal</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Quincenal")">Quincenal</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Mensual")">Mensual</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- 3. Estado -->
                    <MudItem xs="6" sm="3" md="2">
                        <MudSelect T="string" 
                                   Label="Estado" 
                                   Value="_filtroEstado" 
                                   ValueChanged="OnEstadoChanged" 
                                   Dense="true" 
                                   Margin="Margin.Dense" 
                                   Variant="Variant.Outlined" 
                                   AnchorOrigin="Origin.BottomLeft" 
                                   TransformOrigin="Origin.TopLeft"
                                   RelativeWidth="DropdownWidth.Relative"
                                   FullWidth="true">
                            <MudSelectItem T="string" Value="@("")">Todos</MudSelectItem>
                            <MudSelectItem T="string" Value="@("PorCobrar")">Por Cobrar</MudSelectItem>
                            <MudSelectItem T="string" Value="@("Pagado")">Pagados</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- 4. Mes -->
                    <MudItem xs="6" sm="3" md="2">
                        <MudSelect T="int?" 
                                   Label="Mes" 
                                   Value="_filtroMes" 
                                   ValueChanged="OnMesChanged" 
                                   Dense="true" 
                                   Margin="Margin.Dense" 
                                   Variant="Variant.Outlined" 
                                   AnchorOrigin="Origin.BottomLeft" 
                                   TransformOrigin="Origin.TopLeft"
                                   RelativeWidth="DropdownWidth.Relative"
                                   FullWidth="true">
                            <MudSelectItem T="int?" Value="@((int?)null)">Todos los meses</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)1)">Enero</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)2)">Febrero</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)3)">Marzo</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)4)">Abril</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)5)">Mayo</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)6)">Junio</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)7)">Julio</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)8)">Agosto</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)9)">Septiembre</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)10)">Octubre</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)11)">Noviembre</MudSelectItem>
                            <MudSelectItem T="int?" Value="@((int?)12)">Diciembre</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <!-- 5. Año -->
                    <MudItem xs="6" sm="3" md="1">
                        <MudSelect T="int?" 
                                   Label="Año" 
                                   Value="_filtroAno" 
                                   ValueChanged="OnAnoChanged" 
                                   Dense="true" 
                                   Margin="Margin.Dense" 
                                   Variant="Variant.Outlined" 
                                   AnchorOrigin="Origin.BottomLeft" 
                                   TransformOrigin="Origin.TopLeft"
                                   RelativeWidth="DropdownWidth.Relative"
                                   FullWidth="true">
                            <MudSelectItem T="int?" Value="@((int?)null)">Todos</MudSelectItem>
                            @for (int y = DateTime.Now.Year; y >= 2023; y--)
                            {
                                var year = y;
                                <MudSelectItem T="int?" Value="@((int?)year)">@year</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <!-- 6. Botón de Reporte Excel HTML (En la misma fila, ocupando el ancho restante) -->
                    <MudItem xs="12" sm="6" md="2" Class="d-flex align-items-center">
                        <button type="button" 
                                class="btn btn-success text-white w-100 shadow-sm d-flex align-items-center justify-content-center gap-2" 
                                style="height: 40px; font-size: 0.88rem; font-weight: 600; white-space: nowrap;" 
                                @onclick="GenerarReporteExcel" 
                                disabled="@_isExporting"
                                title="Descargar Reporte Ejecutivo en Excel con los filtros aplicados">
                            @if (_isExporting)
                            {
                                <span class="spinner-border spinner-border-sm" role="status"></span>
                                <span>Exportando...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-file-excel fs-6"></i>
                                <span>Reporte Excel</span>
                            }
                        </button>
                    </MudItem>
                </MudGrid>
            </div>
        </div>

        @if (_cargandoFiltro)
        {
            <div class="d-flex justify-content-center align-items-center my-5" style="min-height: 45vh;">
                <div class="text-center">
                    <div class="spinner-border text-primary" style="width: 3.5rem; height: 3.5rem;" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <h6 class="mt-3 text-body-secondary fw-semibold text-uppercase" style="letter-spacing: 1px;">Cargando métricas...</h6>
                </div>
            </div>
        }
        else if (_resumen != null)
        {
            <!-- 4 Tarjetas KPI con tokens dinámicos -->
            <div class="row g-3 mb-3">
                <!-- KPI 1: Capital Prestado -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100 border-start border-4 border-primary">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-body-secondary small fw-semibold text-uppercase">Capital Colocado</span>
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="fa-solid fa-money-bill-wave"></i>
                            </div>
                        </div>
                        <div class="h4 fw-bold text-body mb-1">Bs. @_resumen.TotalCapitalPrestado.ToString("N2")</div>
                        <div class="small text-body-secondary">
                            <span class="text-primary fw-semibold">+Bs. @_resumen.TotalInteresGenerado.ToString("N2")</span> en intereses
                        </div>
                    </div>
                </div>

                <!-- KPI 2: Total Recaudado -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100 border-start border-4 border-success">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-body-secondary small fw-semibold text-uppercase">Total Recaudado</span>
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </div>
                        <div class="h4 fw-bold text-success mb-1">Bs. @_resumen.TotalRecaudado.ToString("N2")</div>
                        <div class="small text-body-secondary">
                            <span>@_resumen.PrestamosPagados préstamos liquidados</span>
                        </div>
                    </div>
                </div>

                <!-- KPI 3: Saldo por Cobrar -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100 border-start border-4 border-danger">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-body-secondary small fw-semibold text-uppercase">Saldo por Cobrar</span>
                            <div class="bg-danger bg-opacity-10 text-danger rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="fa-solid fa-clock"></i>
                            </div>
                        </div>
                        <div class="h4 fw-bold text-danger mb-1">Bs. @_resumen.SaldoPendienteTotal.ToString("N2")</div>
                        <div class="small text-body-secondary">
                            <span>@_resumen.PrestamosActivos préstamos pendientes</span>
                        </div>
                    </div>
                </div>

                <!-- KPI 4: Deuda Total en Cartera -->
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100 border-start border-4 border-info">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="text-body-secondary small fw-semibold text-uppercase">Cartera Total</span>
                            <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="fa-solid fa-vault"></i>
                            </div>
                        </div>
                        <div class="h4 fw-bold text-body mb-1">Bs. @_resumen.TotalMontoCartera.ToString("N2")</div>
                        <div class="small text-body-secondary">
                            <span>@_resumen.TotalPrestamos préstamos en total</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráficos y Desglose Financiero -->
            <div class="row g-3 mb-3">
                <!-- Gráfico de Donut: Progreso de Recaudación (Limpio y sin texto SVG montado) -->
                <div class="col-12 col-lg-5">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="fw-bold text-body mb-0 d-flex align-items-center gap-2">
                                <i class="fa-solid fa-chart-pie text-primary"></i>
                                Progreso de Recaudación
                            </h6>
                            @if (_resumen.TotalMontoCartera > 0)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                                    @PorcentajeRecaudado% Cobrado
                                </span>
                            }
                        </div>

                        <div class="d-flex justify-content-center align-items-center py-2" style="min-height: 220px;">
                            @if (_resumen.TotalMontoCartera > 0 && (_resumen.TotalRecaudado > 0 || _resumen.SaldoPendienteTotal > 0))
                            {
                                <MudChart ChartType="ChartType.Donut" 
                                          Width="210px" 
                                          Height="210px"
                                          InputData="@_donutData" 
                                          InputLabels="@_donutLabels" />
                            }
                            else
                            {
                                <div class="text-center text-body-secondary py-5">
                                    <i class="fa-solid fa-chart-pie fs-1 d-block opacity-25 mb-2"></i>
                                    <span>No hay datos con los filtros seleccionados</span>
                                </div>
                            }
                        </div>

                        <div class="d-flex justify-content-around pt-3 border-top border-secondary-subtle small">
                            <div class="text-center">
                                <span class="d-inline-block rounded-circle bg-success me-1" style="width: 10px; height: 10px;"></span>
                                <span class="text-body-secondary">Abonado:</span>
                                <div class="fw-bold text-success">Bs. @_resumen.TotalRecaudado.ToString("N2")</div>
                            </div>
                            <div class="text-center">
                                <span class="d-inline-block rounded-circle bg-danger me-1" style="width: 10px; height: 10px;"></span>
                                <span class="text-body-secondary">Pendiente:</span>
                                <div class="fw-bold text-danger">Bs. @_resumen.SaldoPendienteTotal.ToString("N2")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Gráfico de Barras: Distribución por Modalidad de Cobro -->
                <div class="col-12 col-lg-7">
                    <div class="card border-0 shadow-sm rounded-4 bg-body p-3 h-100">
                        <h6 class="fw-bold text-body mb-2 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-chart-column text-primary"></i>
                            Distribución por Modalidad de Cobro
                        </h6>
                        <div class="d-flex justify-content-center align-items-center py-2" style="min-height: 220px;">
                            @if (_resumen.DistribucionModalidades.Any())
                            {
                                <MudChart ChartType="ChartType.Bar" 
                                          ChartSeries="@_barSeries" 
                                          XAxisLabels="@_barXLabels" 
                                          Width="100%" 
                                          Height="220px" />
                            }
                            else
                            {
                                <div class="text-center text-body-secondary py-5">
                                    <i class="fa-solid fa-chart-column fs-1 d-block opacity-25 mb-2"></i>
                                    <span>No hay préstamos por modalidad en este filtro</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tabla de Resumen por Modalidad -->
            <div class="card border-0 shadow-sm rounded-4 bg-body mb-4">
                <div class="card-header bg-transparent border-0 pt-3 px-3">
                    <h6 class="fw-bold text-body mb-0 d-flex align-items-center gap-2">
                        <i class="fa-solid fa-table-list text-primary"></i>
                        Detalle Estadístico por Modalidad
                    </h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                            <thead class="bg-body-secondary text-body fw-semibold">
                                <tr>
                                    <th class="ps-3 py-3">Modalidad</th>
                                    <th class="text-center">Cantidad de Préstamos</th>
                                    <th class="text-end">Monto Total Cartera</th>
                                    <th class="text-end pe-3">Participación (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (_resumen.DistribucionModalidades.Any())
                                {
                                    @foreach (var mod in _resumen.DistribucionModalidades)
                                    {
                                        decimal participacion = _resumen.TotalMontoCartera > 0 
                                            ? Math.Round((mod.MontoTotal / _resumen.TotalMontoCartera) * 100m, 1) 
                                            : 0;
                                        <tr>
                                            <td class="ps-3 fw-bold text-body">
                                                <i class="fa-solid fa-calendar-check me-2 text-primary"></i>@mod.Modalidad
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-body-tertiary text-body border px-2 py-1">
                                                    @mod.Cantidad
                                                </span>
                                            </td>
                                            <td class="text-end fw-semibold text-body">Bs. @mod.MontoTotal.ToString("N2")</td>
                                            <td class="text-end pe-3">
                                                <div class="d-flex align-items-center justify-content-end gap-2">
                                                    <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                                                        <div class="progress-bar bg-primary" role="progressbar" style="width: @participacion%" aria-valuenow="@participacion" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <span class="small fw-bold">@participacion%</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-body-secondary">
                                            No se registran préstamos con los filtros seleccionados.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private DashboardResumenDTO? _resumen;
    private List<InstitucionDTO> _instituciones = new();
    private bool _cargandoInicial = true;
    private bool _cargandoFiltro = false;
    private bool _isExporting = false;

    // Filtros con MudSelect
    private int? _filtroInstitucion = null;
    private string _filtroModalidad = "";
    private string _filtroEstado = "";
    private int? _filtroMes = null;
    private int? _filtroAno = null;

    // Datos Gráficos MudBlazor
    private double[] _donutData = new double[0];
    private string[] _donutLabels = new string[] { "Recaudado", "Pendiente" };
    private List<ChartSeries> _barSeries = new();
    private string[] _barXLabels = new string[0];

    private int PorcentajeRecaudado
    {
        get
        {
            if (_resumen == null || _resumen.TotalMontoCartera <= 0) return 0;
            return (int)Math.Round((_resumen.TotalRecaudado / _resumen.TotalMontoCartera) * 100m);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        LayoutService.SetTitle("Dashboard");
        await CargarInstituciones();
        await CargarDashboard();
        _cargandoInicial = false;
    }

    private async Task CargarInstituciones()
    {
        try
        {
            var res = await Api.GetInstitucionesAsync(soloActivos: true);
            if (res.IsSuccess && res.Value != null)
            {
                _instituciones = res.Value;
            }
        }
        catch { }
    }

    private async Task OnInstitucionChanged(int? id)
    {
        _filtroInstitucion = id;
        await CargarDashboard();
    }

    private async Task OnModalidadChanged(string m)
    {
        _filtroModalidad = m;
        await CargarDashboard();
    }

    private async Task OnEstadoChanged(string e)
    {
        _filtroEstado = e;
        await CargarDashboard();
    }

    private async Task OnMesChanged(int? m)
    {
        _filtroMes = m;
        await CargarDashboard();
    }

    private async Task OnAnoChanged(int? a)
    {
        _filtroAno = a;
        await CargarDashboard();
    }

    private async Task CargarDashboard()
    {
        _cargandoFiltro = true;
        try
        {
            var res = await Api.GetDashboardResumenAsync(
                _filtroInstitucion,
                _filtroModalidad,
                _filtroEstado,
                _filtroMes,
                _filtroAno);

            if (res.IsSuccess && res.Value != null)
            {
                _resumen = res.Value;

                // Preparar Donut
                _donutData = new double[] 
                { 
                    (double)_resumen.TotalRecaudado, 
                    (double)_resumen.SaldoPendienteTotal 
                };

                // Preparar Barra
                if (_resumen.DistribucionModalidades.Any())
                {
                    _barXLabels = _resumen.DistribucionModalidades.Select(m => m.Modalidad).ToArray();
                    var valores = _resumen.DistribucionModalidades.Select(m => (double)m.MontoTotal).ToArray();
                    _barSeries = new List<ChartSeries>
                    {
                        new ChartSeries { Name = "Monto Total (Bs)", Data = valores }
                    };
                }
                else
                {
                    _barXLabels = new string[0];
                    _barSeries = new List<ChartSeries>();
                }
            }
            else
            {
                await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al cargar datos del dashboard.");
            }
        }
        catch (Exception ex)
        {
            await msj.ShowErrorMessage("Error al cargar dashboard: " + ex.Message);
        }
        finally
        {
            _cargandoFiltro = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task GenerarReporteExcel()
    {
        try
        {
            _isExporting = true;
            string tituloReporte = "Reporte Ejecutivo de Cartera";
            var res = await Api.GenerarReporteExcelAsync(
                _filtroInstitucion,
                _filtroModalidad,
                _filtroEstado,
                _filtroMes,
                _filtroAno,
                null,
                null,
                tituloReporte);

            if (res.IsSuccess && res.Value != null)
            {
                var base64 = Convert.ToBase64String(res.Value);
                var fileName = $"Reporte_Cartera_{DateTime.Now:yyyyMMdd_HHmm}.xlsx";
                await JS.InvokeVoidAsync("descargarArchivoBase64", fileName, base64);
                await msj.ShowSuccessMessage("Reporte Excel descargado exitosamente.");
            }
            else
            {
                await msj.ShowErrorMessage(res.ErrorMessage ?? "Error al generar reporte Excel.");
            }
        }
        catch (Exception ex)
        {
            await msj.ShowErrorMessage($"Error al exportar: {ex.Message}");
        }
        finally
        {
            _isExporting = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}
