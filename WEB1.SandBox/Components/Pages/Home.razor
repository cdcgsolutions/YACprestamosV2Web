@page "/"
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using WEB1.SandBox.Services
@using WEB1.SandBox.DTOs
@using WEB1.SandBox.Helpers
@attribute [Authorize]
@inject NavigationManager NavigationManager
@inject LayoutService LayoutService
@inject ModuleService ModuleService
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Inicio | @(Configuration["app:Name"] ?? "YAC-Préstamos")</PageTitle>

<div class="container-fluid px-2 px-md-4 py-3 py-md-4">
    <!-- Encabezado Minimalista y Ejecutivo -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4 pb-3 border-bottom border-secondary-subtle gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="text-body-secondary small">
                    <i class="fa-regular fa-calendar me-1"></i> @FechaActualFormateada
                </span>
            </div>
            <h2 class="fw-bold text-body mb-0">
                @MensajeBienvenida, <span>@(_userName ?? "Usuario")</span>
            </h2>
        </div>
    </div>

    <!-- Cuadrícula de Interfaces del Sistema -->
    <div class="row g-3 g-md-4">
        @for (int i = 0; i < _interfaces.Count; i++)
        {
            var item = _interfaces[i];
            var theme = BootstrapColorHelper.GetTheme(i);

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm rounded-4 bg-body hub-card @theme.CardThemeClass p-4 cursor-pointer"
                     @onclick="() => NavegarA(item.path)">
                    <div class="d-flex align-items-center justify-content-between mb-4">
                        <div class="hub-icon-wrapper rounded-4 d-flex align-items-center justify-content-center @theme.BgSubtleClass @theme.TextClass">
                            <i class="@item.icon fs-2"></i>
                        </div>
                        <div class="hub-arrow rounded-circle d-flex align-items-center justify-content-center">
                            <i class="fa-solid fa-arrow-right"></i>
                        </div>
                    </div>
                    <h4 class="fw-bold text-body mb-1">@item.name</h4>
                    <p class="text-body-secondary small mb-0">@item.description</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string? _userName;
    private string? _userRole;
    private List<InterfaceDTO> _interfaces = new();

    private string MensajeBienvenida
    {
        get
        {
            var hora = DateTime.Now.Hour;
            if (hora < 12) return "Buenos días";
            if (hora < 19) return "Buenas tardes";
            return "Buenas noches";
        }
    }

    private string FechaActualFormateada =>
        DateTime.Now.ToString("dddd, dd 'de' MMMM 'de' yyyy", new CultureInfo("es-ES"));

    protected override async Task OnInitializedAsync()
    {
        LayoutService.SetTitle("Inicio");

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _userName = user.Identity.Name;
                _userRole = user.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value 
                            ?? user.Claims.FirstOrDefault(c => c.Type == "role")?.Value 
                            ?? "Operador";
            }
        }
        catch { }

        try
        {
            var modules = await ModuleService.GetModulesAsync();
            _interfaces = modules.FirstOrDefault()?.interfaceList?.Where(x => x.status).ToList() ?? new();
        }
        catch { }
    }

    private void NavegarA(string ruta)
    {
        var cleanPath = ruta.TrimStart('/');
        NavigationManager.NavigateTo($"/{cleanPath}");
    }
}
