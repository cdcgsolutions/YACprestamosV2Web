@page "/examples/components"
@using MudBlazor
@using WEB1.Module.Client.Services
@inject LayoutService LayoutService
@inject FloatingMessage FloatingMessage

<PageTitle>Showcase de Componentes - MudBlazor</PageTitle>

<div class="container-fluid p-4">
    <div class="mb-4">
        <h2 class="fw-bold">Showcase de Componentes MudBlazor</h2>
        <p class="text-muted">Componentes Material Design listos para usar en tus pantallas.</p>
    </div>

    <!-- Cards & Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <MudCard Elevation="2" Class="rounded-xl h-100 pa-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Ventas Totales</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Success" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h4" Class="fw-bold text-success">$12,450.00</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">+15% respecto al mes anterior</MudText>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-md-4">
            <MudCard Elevation="2" Class="rounded-xl h-100 pa-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Usuarios Activos</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudText Typo="Typo.h4" Class="fw-bold text-primary">1,280</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">En línea en este momento</MudText>
                </MudCardContent>
            </MudCard>
        </div>
        <div class="col-md-4">
            <MudCard Elevation="2" Class="rounded-xl h-100 pa-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Estado del Sistema</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Info" />
                    </CardHeaderActions>
                </MudCardHeader>
                <MudCardContent>
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">100% Operativo</MudChip>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Todos los servicios respondiendo</MudText>
                </MudCardContent>
            </MudCard>
        </div>
    </div>

    <!-- Botones y Notificaciones FloatingMessage -->
    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <MudCard Elevation="2" Class="rounded-xl pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Botones con FloatingMessage (Toastr)</MudText>
                <div class="d-flex flex-wrap gap-2 mb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => FloatingMessage.Info("Acción primaria ejecutada"))">Primario</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => FloatingMessage.Success("Guardado exitosamente"))">Éxito</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="@(() => FloatingMessage.Warning("Advertencia"))">Advertencia</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => FloatingMessage.Error("Error al procesar"))">Error</MudButton>
                </div>
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-lg">
                    MudBlazor ofrece más de 60 componentes listos sin JavaScript externo.
                </MudAlert>
            </MudCard>
        </div>
        <div class="col-md-6">
            <MudCard Elevation="2" Class="rounded-xl pa-4">
                <MudText Typo="Typo.h6" Class="mb-3">Entradas de Texto y Selectores</MudText>
                <MudTextField @bind-Value="_sampleText" Label="Texto de Ejemplo" Variant="Variant.Outlined" Class="mb-3" />
                <MudSelect @bind-Value="_selectedOption" Label="Selecciona una opción" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Opción 1")">Opción 1</MudSelectItem>
                    <MudSelectItem Value="@("Opción 2")">Opción 2</MudSelectItem>
                    <MudSelectItem Value="@("Opción 3")">Opción 3</MudSelectItem>
                </MudSelect>
            </MudCard>
        </div>
    </div>
</div>

@code {
    private string _sampleText = "Valor predeterminado";
    private string _selectedOption = "Opción 1";

    protected override void OnInitialized()
    {
        LayoutService.SetTitle("Showcase de Componentes");
    }
}
