@page "/login"
@layout LoginLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@using MudBlazor
@using WEB1.SandBox.DTOs
@using WEB1.SandBox.Services
@using WEB1.Module.Client.Services
@inject AuthService AuthService
@inject NavigationManager NavigationManager
@inject FloatingMessage FloatingMessage

<PageTitle>Iniciar Sesión | YAC-Préstamos</PageTitle>

<div class="login-wrapper d-flex align-items-center justify-content-center min-vh-100 p-3 p-md-4">
    <!-- Card Principal Split Elegante estilo SIS.INV -->
    <div class="card login-card border-0 shadow-lg overflow-hidden" style="max-width: 880px; width: 100%; border-radius: 1.25rem;">
        <div class="row g-0">
            <!-- Columna Izquierda: Banner Visual con loginOffice.png (Visible en Desktop) -->
            <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-4 p-xl-5 text-white position-relative login-brand-side">
                <div class="position-relative z-2">
                    <div class="d-flex align-items-center gap-3">
                        <div class="brand-icon-box shadow-sm">
                            <i class="fa-solid fa-hand-holding-dollar fs-3 text-primary"></i>
                        </div>
                        <div>
                            <div class="fs-4 fw-bold tracking-wide text-white">YAC. PRÉSTAMOS</div>
                        </div>
                    </div>
                </div>

                <div class="position-relative z-2 pt-4 border-top border-light border-opacity-10 text-white-50 small d-flex justify-content-between">
                    <span>© @DateTime.Now.Year YAC-Préstamos</span>
                    <span class="text-primary fw-semibold">v1.0</span>
                </div>
            </div>

            <!-- Columna Derecha: Formulario con Colores Estáticos Nítidos -->
            <div class="col-12 col-lg-7 p-4 p-md-5 d-flex flex-column justify-content-center bg-white">
                <div class="text-center mb-4">
                    <div class="brand-icon-box mx-auto mb-3 shadow d-lg-none">
                        <i class="fa-solid fa-hand-holding-dollar fs-2 text-primary"></i>
                    </div>
                    <h4 class="fw-bold mb-1" style="color: #0f172a;">Bienvenido</h4>
                    <p class="small mb-0" style="color: #64748b;">Ingresa tus credenciales para acceder al sistema</p>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 mb-3 rounded-3" role="alert">
                        <i class="fa-solid fa-triangle-exclamation fs-6"></i>
                        <span>@_errorMessage</span>
                    </div>
                }

                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <MudTextField @bind-Value="_loginModel.UserName"
                                      Label="Usuario o Correo"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.PersonOutline"
                                      AdornmentColor="Color.Primary"
                                      Class="custom-login-field"
                                      For="@(() => _loginModel.UserName)"
                                      Disabled="@_isProcessing"
                                      FullWidth="true" />
                    </div>

                    <div class="mb-4">
                        <MudTextField @bind-Value="_loginModel.Password"
                                      Label="Contraseña"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      InputType="@_passwordInputType"
                                      Adornment="Adornment.End"
                                      AdornmentIcon="@_passwordIcon"
                                      AdornmentColor="Color.Primary"
                                      Class="custom-login-field"
                                      OnAdornmentClick="TogglePasswordVisibility"
                                      For="@(() => _loginModel.Password)"
                                      Disabled="@_isProcessing"
                                      FullWidth="true" />
                    </div>

                    <MudButton ButtonType="ButtonType.Submit"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               FullWidth="true"
                               Class="py-3 rounded-3 fw-bold text-white shadow-sm d-flex align-items-center justify-content-center gap-2"
                               Disabled="@_isProcessing">
                        @if (_isProcessing)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Autenticando...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>
                            <span>Iniciar Sesión</span>
                        }
                    </MudButton>
                </EditForm>

                <!-- Pie de página con créditos CDCGsolutions -->
                <div class="text-center mt-4 pt-3 border-top border-light-subtle">
                    <div class="small" style="font-size: 0.78rem; color: #64748b;">
                        &copy; @DateTime.Now.Year &bull; Desarrollado por <strong style="color: #0f172a;">CDCGsolutions</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .login-wrapper {
        background: radial-gradient(circle at 10% 20%, #1e293b 0%, #0b1120 90%);
        min-height: 100vh;
    }

    .login-card {
        background-color: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
    }

    .login-brand-side {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.88), rgba(30, 41, 59, 0.82)), url('/brand/loginOffice.png') center/cover no-repeat;
        border-right: 1px solid rgba(0, 0, 0, 0.08);
        min-height: 480px;
    }

    .brand-icon-box {
        width: 60px;
        height: 60px;
        border-radius: 16px;
        background: rgba(13, 110, 253, 0.12);
        border: 1px solid rgba(13, 110, 253, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 0 20px rgba(13, 110, 253, 0.2);
    }

    .tracking-wide {
        letter-spacing: 1.5px;
    }

    /* Colores estáticos negros para labels e inputs en fondo blanco */
    .custom-login-field input {
        color: #0f172a !important;
        font-weight: 500 !important;
    }

    .custom-login-field label,
    .custom-login-field .mud-input-label,
    .custom-login-field .mud-input-label-outlined {
        color: #334155 !important;
        font-weight: 600 !important;
    }

    .custom-login-field .mud-input-outlined-border {
        border-color: #cbd5e1 !important;
    }

    .custom-login-field:hover .mud-input-outlined-border {
        border-color: #64748b !important;
    }

    .custom-login-field.mud-input-focused .mud-input-outlined-border {
        border-color: #0d6efd !important;
    }

    .custom-login-field.mud-input-focused label,
    .custom-login-field.mud-input-focused .mud-input-label-outlined {
        color: #0d6efd !important;
    }

    /* Corrección de autocompletado en fondo blanco */
    .custom-login-field input:-webkit-autofill,
    .custom-login-field input:-webkit-autofill:hover, 
    .custom-login-field input:-webkit-autofill:focus, 
    .custom-login-field input:-webkit-autofill:active {
        -webkit-box-shadow: 0 0 0 1000px #ffffff inset !important;
        -webkit-text-fill-color: #0f172a !important;
        caret-color: #0f172a !important;
        transition: background-color 5000s ease-in-out 0s !important;
    }
</style>

@code {
    private LoginDTO _loginModel = new();
    private bool _isProcessing = false;
    private string? _errorMessage;

    private bool _showPassword = false;
    private InputType _passwordInputType = InputType.Password;
    private string _passwordIcon = Icons.Material.Filled.VisibilityOff;

    private void TogglePasswordVisibility()
    {
        _showPassword = !_showPassword;
        _passwordInputType = _showPassword ? InputType.Text : InputType.Password;
        _passwordIcon = _showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff;
    }

    private async Task HandleLogin()
    {
        _isProcessing = true;
        _errorMessage = null;

        var (success, message) = await AuthService.LoginAsync(_loginModel);

        if (success)
        {
            await FloatingMessage.Success(message);
            NavigationManager.NavigateTo("/");
        }
        else
        {
            _errorMessage = message;
            await FloatingMessage.Error(message);
        }

        _isProcessing = false;
    }
}
