@inherits LayoutComponentBase
@implements IDisposable
@using MudBlazor
@using System.Security.Claims
@using WEB1.SandBox.DTOs
@using WEB1.SandBox.Services
@using WEB1.Module.Client.Services
@inject IJSRuntime IJSRuntime
@inject NavigationManager NavigationManager
@inject AuthService AuthService
@inject LayoutService LayoutService
@inject ModuleService ModuleService
@inject IConfiguration Configuration

<MudThemeProvider IsDarkMode="@_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<AuthorizeView>
    <Authorized>
        <!-- App Mode Strip -->
        @if (GetAppMode() != "PRO")
        {
            <div class="app-mode-strip w-100 text-center fw-bold text-white small py-0" style="background-color: @GetModeColor(); position: fixed; top: 0; z-index: 1040; height: 1.5rem; line-height: 1.5rem;">
                TIPO DE AMBIENTE: @GetAppMode()
            </div>
        }

        <!-- Header Section -->
        <header class="pos-header d-flex align-items-center justify-content-between px-4 position-fixed start-0 w-100 bg-body transition-all" 
                style="@(GetAppMode() != "PRO" ? "top: 1.5rem;" : "top: 0;")">
            <div class="header-title-container d-flex align-items-center">
                <span class="brand-title h4 mb-0 cursor-pointer ms-0 fw-bold text-primary" @onclick="NavigateHome">
                    @(Configuration["app:Name"] ?? "WEB1")
                </span>
                <div class="vertical-divider mx-3 border-start" style="height: 24px;"></div>
                <span class="page-title text-secondary">@LayoutService.CurrentTitle</span>
            </div>

            <div class="search-container flex-grow-1 mx-5 d-none d-md-block">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute text-muted" style="top: 10px; left: 12px;"></i>
                    <input type="text" class="form-control ps-5 rounded-pill shadow-sm" placeholder="Buscar módulos o acciones..." 
                           @onclick="@(async () => await OpenCommandPalette())" @onfocus="@(async () => await OpenCommandPalette())" readonly />
                </div>
            </div>

            <div class="header-right d-flex align-items-center gap-3">
                <!-- Role Badge -->
                <div class="d-none d-md-flex align-items-center me-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary border px-3 py-2 rounded-pill d-flex align-items-center">
                        <i class="bi bi-shield-check me-2"></i>
                        <span class="fw-bold">@UserRole</span>
                    </span>
                </div>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center shadow-sm cursor-pointer" 
                         style="width: 40px; height: 40px; font-size: 1rem; cursor: pointer;" 
                         title="@context.User.Identity?.Name" 
                         data-bs-toggle="dropdown" 
                         aria-expanded="false">
                        @GetInitials(context.User.Identity?.Name)
                    </div>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2" style="min-width: 240px;">
                        <li class="px-3 py-3 bg-body-tertiary">
                            <div class="d-flex align-items-center">
                                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3 shadow-sm" style="width: 48px; height: 48px; font-size: 1.2rem;">
                                    @GetInitials(context.User.Identity?.Name)
                                </div>
                                <div class="overflow-hidden">
                                    <h6 class="mb-0 fw-bold text-truncate">@context.User.Identity?.Name</h6>
                                    <small class="text-secondary d-block text-truncate">@UserEmail</small>
                                    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill mt-1 text-xs">
                                        @UserRole
                                    </span>
                                </div>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        
                        <!-- Theme Switcher -->
                        <li><h6 class="dropdown-header text-uppercase small fw-bold">Tema</h6></li>
                        <li>
                            <div class="d-flex gx-2 px-3 pb-2">
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1 me-1 @(_currentTheme == "light" ? "active" : "")" @onclick="@(() => SetTheme("light"))" title="Modo Claro">
                                    <i class="bi bi-sun-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1 me-1 @(_currentTheme == "dark" ? "active" : "")" @onclick="@(() => SetTheme("dark"))" title="Modo Oscuro">
                                    <i class="bi bi-moon-stars-fill"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-secondary flex-grow-1 @(_currentTheme == "auto" ? "active" : "")" @onclick="@(() => SetTheme("auto"))" title="Automático">
                                    <i class="bi bi-circle-half"></i>
                                </button>
                            </div>
                        </li>

                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <button class="dropdown-item py-2 text-danger d-flex align-items-center" @onclick="HandleLogout">
                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <CommandPalette @ref="commandPalette" Modules="@valuesParameters?.Modules" />

        <div style="@($"height:Calc(100dvh - {(GetAppMode() != "PRO" ? "84px" : "60px")}); margin-top:{(GetAppMode() != "PRO" ? "84px" : "60px")};")" class="d-flex overflow-hidden">
            <CascadingValue Value="@valuesParameters">
                <CascadingValue Value="@valuesParameters?.Modules">
                    <main class="h-100 w-100 overflow-auto bg-body-tertiary p-4">
                        @Body
                    </main>
                </CascadingValue>
            </CascadingValue>
        </div>
    </Authorized>
    <NotAuthorized>
        @Body
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    public Task<AuthenticationState>? authenticationStateTask { get; set; }

    private ValuesParameters valuesParameters = new();
    private string UserRole { get; set; } = "Usuario";
    private string UserEmail { get; set; } = string.Empty;
    private CommandPalette? commandPalette;

    private bool _isDarkMode = false;
    private string _currentTheme = "auto";

    protected override async Task OnInitializedAsync()
    {
        LayoutService.OnTitleChanged += HandleTitleChanged;
        ModuleService.OnModulesChanged += HandleModulesChanged;
        var modules = await ModuleService.GetModulesAsync();
        valuesParameters = new ValuesParameters { Modules = modules };
    }

    private void HandleTitleChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private void HandleModulesChanged()
    {
        valuesParameters = new ValuesParameters { Modules = ModuleService.Modules };
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedTheme = await IJSRuntime.InvokeAsync<string>("localStorage.getItem", "theme");
                if (!string.IsNullOrEmpty(savedTheme))
                {
                    _currentTheme = savedTheme;
                    _isDarkMode = savedTheme == "dark";
                    StateHasChanged();
                }
            }
            catch {}
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authenticationStateTask != null)
        {
            var authState = await authenticationStateTask;
            var user = authState.User;

            if (user.Identity != null && user.Identity.IsAuthenticated)
            {
                UserEmail = user.FindFirst(ClaimTypes.Email)?.Value ?? $"{user.Identity.Name}@sistema.local";
                UserRole = user.FindFirst(ClaimTypes.Role)?.Value ?? "User";
            }
        }
    }

    public void Dispose()
    {
        LayoutService.OnTitleChanged -= HandleTitleChanged;
        ModuleService.OnModulesChanged -= HandleModulesChanged;
    }

    private async Task SetTheme(string theme)
    {
        _currentTheme = theme;
        _isDarkMode = theme == "dark";
        try
        {
            await IJSRuntime.InvokeVoidAsync("settheme", theme);
        }
        catch {}
        StateHasChanged();
    }

    private string GetAppMode() => Configuration["app:Mode"] ?? "DEV";

    private string GetModeColor() => GetAppMode() switch
    {
        "PRO" => "#0d6efd",
        "QA" => "#0dcaf0",
        "DEV" => "#ffc107",
        _ => "#6c757d"
    };

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        return name.Length > 0 ? name.Substring(0, 1).ToUpper() : "U";
    }

    private async Task OpenCommandPalette()
    {
        if (commandPalette != null)
        {
            await commandPalette.Open();
        }
    }

    private void NavigateHome() => NavigationManager.NavigateTo("/");

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/login");
    }
}